{
  "name": "@grow-codes/zipkin",
  "version": "0.1.0",
  "description": "Grow Codes SDK for Zipkin (TypeScript)",
  "keywords": [
    "zipkin",
    "grow-codes",
    "sdk"
  ],
  "author": "Grow Codes <opensource@grow.codes>",
  "license": "Apache-2.0",
  "homepage": "https://grow-codes-packages.github.io/zipkin/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grow-codes-packages/zipkin.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/grow-codes-packages/zipkin/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./lib/testing/index.d.ts",
        "default": "./lib/testing/index.js"
      },
      "require": {
        "types": "./lib/testing/index.d.cts",
        "default": "./lib/testing/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage && node scripts/coverage-summary.mjs",
    "docs": "typedoc",
    "license": "node scripts/license-check.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.1",
    "@opentelemetry/otlp-exporter-base": "^0.301.1",
    "@opentelemetry/propagator-b3": "^3.1.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "undici": "^8.12.4"
  },
  "peerDependencies": {
    "express": ">=4.18.0",
    "fastify": ">=4.0.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "ajv": "^8.20.0",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
