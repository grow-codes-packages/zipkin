# Generated by sdk-kit 0.3.0 — do not edit; change sdk-kit and run "sdk-kit sync"
#
# Go package Makefile (contract shared by all languages):
#   deps build lint test coverage license pack docs clean

GO             ?= go
GOFLAGS        ?= -p=4
export GOFLAGS

COVER_MIN      ?= 90
GOLANGCI_VER   ?= v2.15.0
GOLICENSES_VER ?= v2.0.1
GOLANGCI_LINT  ?= $(shell command -v golangci-lint 2>/dev/null || echo "$(GO) run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$(GOLANGCI_VER)")
GO_LICENSES    ?= $(shell command -v go-licenses 2>/dev/null || echo "$(GO) run github.com/google/go-licenses/v2@$(GOLICENSES_VER)")
MODULE         := github.com/grow-codes-packages/zipkin/go
RELEASE_CHECK  ?= python3 ../.github/scripts/release-check.py
ALLOWED_LICENSES := Apache-2.0,MIT,MIT-0,BSD-2-Clause,BSD-3-Clause,ISC,Zlib,Unicode-3.0,Unicode-DFS-2016,0BSD,CC0-1.0,MPL-2.0

# First-party packages measured by the coverage gate (build tools excluded).
COVER_PKGS = $(shell $(GO) list ./... | grep -v '/internal/tools/' | paste -sd, -)

.PHONY: deps build lint test coverage license pack release-check docs clean integration

deps:
	$(GO) mod tidy
	$(GO) mod download
	$(GO) mod verify

build:
	$(GO) build ./...
	$(GO) test -count=1 -run '^$$' ./... >/dev/null

lint:
	@out="$$(gofmt -l .)"; if [ -n "$$out" ]; then echo "gofmt needed:"; echo "$$out"; exit 1; fi
	$(GO) vet ./...
	$(GOLANGCI_LINT) run ./...

test:
	$(GO) test -race -count=1 ./...

coverage:
	@mkdir -p coverage
	$(GO) test -count=1 -covermode=atomic -coverpkg=$(COVER_PKGS) -coverprofile=coverage/coverage.out ./...
	$(GO) run ./internal/tools/covergate -profile coverage/coverage.out -min $(COVER_MIN) -summary coverage/summary.json

license:
	$(GO_LICENSES) check ./... --ignore $(MODULE) --allowed_licenses=$(ALLOWED_LICENSES)

# Go modules are published as source: nothing to pack. dist/ stays empty on purpose.
pack:
	@mkdir -p dist
	@echo "Go modules are distributed as source; nothing to pack."

# Release readiness: module path github.com/grow-codes-packages/zipkin/go, no replace directives,
# go.mod/go.sum tidy, version.go equal to the release-please manifest (initial-version before the
# first release). The release itself is the go/vX.Y.Z tag.
release-check:
	$(RELEASE_CHECK) go
	$(GO) mod tidy -diff

docs:
	@mkdir -p docs-out
	@for p in $$($(GO) list ./... | grep -v '/internal/'); do $(GO) doc -all $$p; done > docs-out/api.txt
	@echo "API docs written to docs-out/api.txt (pkg.go.dev renders the doc comments)."

# Runs the consumer module against a live service (used by docker/Dockerfile.go).
integration:
	cd integration && $(GO) mod tidy && $(GO) test -count=1 -v ./...

clean:
	rm -rf coverage dist docs-out
