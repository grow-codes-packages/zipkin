# Generated by sdk-kit 0.3.0 — do not edit; change sdk-kit and run "sdk-kit sync"
#
# Rust integration image (SPEC §8). Build context = repository root.
# 1. package the crate (`cargo package`) and unpack the `.crate` like a registry download
# 2. build the consumer crate rust/integration against the unpacked package (path dependency)
# 3. CMD runs the integration tests + conformance runner against the real service
FROM rust:1.99-bookworm

ENV CARGO_TERM_COLOR=never \
    CARGO_BUILD_JOBS=4 \
    CARGO_TARGET_DIR=/tmp/target \
    GROW_CONFORMANCE_DIR=/work/conformance/scenarios \
    GROW_BOOTSTRAP_ENV=/bootstrap/env

COPY conformance/ /work/conformance/
COPY rust/ /src/rust/

WORKDIR /src/rust
RUN rm -rf target coverage dist integration/target \
    && (test -f Cargo.lock || cargo generate-lockfile) \
    && cargo package --locked --allow-dirty --no-verify \
    && mkdir -p /work/pkg \
    && tar -xzf "$(ls "$CARGO_TARGET_DIR"/package/grow-zipkin-*.crate | head -n 1)" -C /work/pkg --strip-components=1 \
    && cp -r /src/rust/integration /work/pkg/integration \
    && (test -f /work/pkg/integration/Cargo.lock || cp /src/rust/Cargo.lock /work/pkg/integration/Cargo.lock)

WORKDIR /work/pkg/integration
# Resolve against the package's lockfile, then build everything so the test run is offline.
RUN cargo test --no-run && cargo test --locked --offline --no-run

CMD ["cargo", "test", "--locked", "--offline", "--", "--test-threads=1", "--nocapture"]
