# Generated by sdk-kit 0.2.0 — do not edit; change sdk-kit and run "sdk-kit sync"
#
# TypeScript integration image. Build context: repository root.
# Builds and packs @grow-codes/zipkin (npm tarball), installs the tarball into
# typescript/integration like a user project would, then runs the integration and
# conformance tests against the service from docker/compose.yml.
FROM node:24-bookworm-slim

ENV NODE_ENV=development \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false

WORKDIR /repo/typescript
COPY typescript/package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

# Copy sources explicitly so a host node_modules/ never overrides the npm ci result.
COPY typescript/tsconfig.json typescript/tsup.config.ts typescript/README.md ./
COPY typescript/src/ ./src/
COPY typescript/integration/package.json ./integration/
COPY typescript/integration/test/ ./integration/test/
COPY conformance/ /repo/conformance/
COPY LICENSE NOTICE ./
RUN npm run build \
    && mkdir -p dist \
    && npm pack --ignore-scripts --pack-destination dist

# Consumer project: only the packed tarball is installed, never the source tree.
WORKDIR /repo/typescript/integration
RUN npm install --no-save ../dist/*.tgz

# Reads /bootstrap/env and GROW_ZIPKIN_URL at run time.
CMD ["npm", "test"]
