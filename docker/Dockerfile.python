# Generated by sdk-kit 0.3.0 — do not edit; change sdk-kit and run "sdk-kit sync"
#
# Python integration suite for Zipkin (SPEC section 8). Build context: repository root.
#   1. build the wheel + sdist of grow-zipkin (like a release would),
#   2. install the wheel into a clean consumer environment (python/integration),
#   3. run the consumer's pytest suite (core + category conformance) against the real service.
# The suite reads /bootstrap/env and GROW_ZIPKIN_URL (set by docker/compose.yml).

FROM python:3.13-slim-bookworm AS build
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /src/python
RUN python -m pip install "build>=1.2"
COPY LICENSE NOTICE ./
COPY python/pyproject.toml python/README.md ./
COPY python/src ./src
RUN python -m build --outdir /dist . && ls -l /dist

FROM python:3.13-slim-bookworm
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 GROW_CONFORMANCE_DIR=/consumer/conformance/scenarios
RUN useradd --create-home --uid 10001 tester
WORKDIR /consumer
COPY --from=build /dist /dist
COPY python/integration/requirements.txt ./requirements.txt
RUN python -m pip install -r requirements.txt "$(ls /dist/*.whl)[all]"
COPY python/integration/ ./
COPY conformance ./conformance
USER tester
CMD ["python", "-m", "pytest"]
