# Generated by sdk-kit 0.2.0 — Rust package targets (also used by CI).
CARGO ?= cargo
CRATE := grow-zipkin
# Read from Cargo.toml: release-please bumps it there.
VERSION = $(shell sed -n 's/^version *= *"\(.*\)"/\1/p' Cargo.toml | head -n 1)
RELEASE_CHECK ?= python3 ../.github/scripts/release-check.py
export CARGO_BUILD_JOBS ?= 4
TARGET_DIR = $(or $(CARGO_TARGET_DIR),target)

.PHONY: deps build lint test coverage license pack release-check docs clean

deps:
	@test -f Cargo.lock || $(CARGO) generate-lockfile
	$(CARGO) fetch

build:
	$(CARGO) build --all-features --all-targets
	$(CARGO) build --no-default-features

lint:
	$(CARGO) fmt --all --check
	$(CARGO) clippy --all-targets --all-features -- -D warnings
	$(CARGO) clippy --lib --no-default-features -- -D warnings

test:
	$(CARGO) test --all-features

# Fails below 90 % lines or regions (SPEC §7) and writes coverage/summary.json.
coverage:
	@mkdir -p coverage
	@status=0; \
	$(CARGO) llvm-cov --all-features --fail-under-lines 90 --fail-under-regions 90 \
		--json --summary-only --output-path coverage/llvm-cov.json || status=$$?; \
	python3 -c 'import json; t = json.load(open("coverage/llvm-cov.json"))["data"][0]["totals"]; \
	m = lambda k: {"covered": t[k]["covered"], "total": t[k]["count"], "pct": round(t[k]["percent"], 2)}; \
	json.dump({"lines": m("lines"), "branches": None, "regions": m("regions"), "functions": m("functions")}, \
	open("coverage/summary.json", "w"), indent=2)'; \
	cat coverage/summary.json; echo; \
	exit $$status

license:
	$(CARGO) deny check licenses bans sources

pack:
	@mkdir -p dist
	$(CARGO) package --allow-dirty
	cp "$(TARGET_DIR)/package/$(CRATE)-$(VERSION).crate" dist/

# Release readiness (CI runs it after pack): crates.io metadata (description, licence, repository,
# readme, <= 5 keywords, valid categories, no git/path-only dependencies), then a dry-run publish.
release-check: pack
	CARGO="$(CARGO)" $(RELEASE_CHECK) rust
	$(CARGO) publish --dry-run --allow-dirty

docs:
	RUSTDOCFLAGS="-D warnings" $(CARGO) doc --all-features --no-deps

clean:
	$(CARGO) clean -p $(CRATE)
	rm -rf coverage dist
