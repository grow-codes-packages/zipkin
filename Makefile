# Generated by sdk-kit 0.2.0 — do not edit; change sdk-kit and run "sdk-kit sync"
#
# Root Makefile of the Grow Codes SDK for Zipkin. Every target delegates to the language
# Makefiles (<lang>/Makefile has the same targets). Pick languages with LANGS:
#   make test LANGS="go python"
#   make test-docker LANGS=rust

SHELL := /bin/sh
LANGS ?= typescript rust go python java
COMPOSE_FILE ?= docker/compose.yml
# Shared hosts serialise Docker suites through one of four lock files when this directory exists.
SDK_DOCKER_LOCK_DIR ?= $(HOME)/grow/.artifcats/locks
SDK_KIT ?= sdk-kit

LANG_TARGETS := deps build lint test coverage license pack clean

.PHONY: all help $(LANG_TARGETS) docs docs-site test-docker check sync release-config release-check

all: build

help:
	@echo "Targets: deps build lint test coverage license pack release-check docs test-docker check sync clean"
	@echo "LANGS=\"$(LANGS)\""

$(LANG_TARGETS):
	@set -e; for lang in $(LANGS); do \
	  echo "==> $$lang: make $@"; \
	  $(MAKE) --no-print-directory -C $$lang $@; \
	done

docs:
	@set -e; for lang in $(LANGS); do \
	  echo "==> $$lang: make docs"; \
	  $(MAKE) --no-print-directory -C $$lang docs; \
	done
	@$(MAKE) --no-print-directory docs-site

docs-site:
	mkdocs build --strict

check:
	$(SDK_KIT) check --dest .

# Release readiness. release-config: release-please-config.json has the five packages with the
# registry names of .sdk-kit.json, the version extra-files, and .release-please-manifest.json lists
# all five; every package carries the version release-please expects. release-check: that plus the
# language checks (metadata + dry-run publish) for LANGS.
release-config:
	python3 .github/scripts/release-check.py config

release-check: release-config
	@set -e; for lang in $(LANGS); do \
	  echo "==> $$lang: make release-check"; \
	  $(MAKE) --no-print-directory -C $$lang release-check; \
	done

sync:
	$(SDK_KIT) sync --dest .

# One integration run per language: unique Compose project, no host ports, and a trap that always
# removes the stack with its volumes (also on failure and Ctrl-C).
define TEST_DOCKER_SCRIPT
set -u
lang="$$1"
suffix=$$(LC_ALL=C tr -dc 'a-z0-9' </dev/urandom 2>/dev/null | head -c 8)
project="zipkin-$$lang-$${suffix:-$$$$}"
compose() { docker compose -f "$(COMPOSE_FILE)" -p "$$project" --profile "$$lang" "$$@"; }
cleanup() { rc=$$?; if [ "$$rc" -ne 0 ] && [ -n "$${COMPOSE_LOGS_DIR:-}" ]; then mkdir -p "$$COMPOSE_LOGS_DIR"; compose logs --no-color --timestamps > "$$COMPOSE_LOGS_DIR/$$project.log" 2>&1 || true; fi; compose down -v --remove-orphans >/dev/null 2>&1 || true; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
echo "==> $$lang: docker integration (project $$project)"
compose run --rm --build "test-$$lang"
endef
export TEST_DOCKER_SCRIPT

test-docker:
	@failed=""; \
	for lang in $(LANGS); do \
	  if [ -d "$(SDK_DOCKER_LOCK_DIR)" ] && command -v flock >/dev/null 2>&1; then \
	    rc=75; \
	    for n in 1 2 3 4; do \
	      flock -n -E 75 "$(SDK_DOCKER_LOCK_DIR)/sdk-docker-$$n.lock" sh -c "$$TEST_DOCKER_SCRIPT" sh "$$lang"; \
	      rc=$$?; \
	      [ $$rc -eq 75 ] || break; \
	    done; \
	    if [ $$rc -eq 75 ]; then \
	      n=$$(( $$(od -An -N1 -tu1 /dev/urandom | tr -d ' ') % 4 + 1 )); \
	      echo "==> $$lang: all Docker locks busy, waiting for sdk-docker-$$n.lock"; \
	      flock "$(SDK_DOCKER_LOCK_DIR)/sdk-docker-$$n.lock" sh -c "$$TEST_DOCKER_SCRIPT" sh "$$lang"; \
	      rc=$$?; \
	    fi; \
	  else \
	    sh -c "$$TEST_DOCKER_SCRIPT" sh "$$lang"; \
	    rc=$$?; \
	  fi; \
	  [ $$rc -eq 0 ] || failed="$$failed $$lang"; \
	  [ $$rc -ne 130 ] && [ $$rc -ne 143 ] || exit $$rc; \
	done; \
	if [ -n "$$failed" ]; then echo "docker integration failed for:$$failed"; exit 1; fi; \
	echo "docker integration passed: $(LANGS)"
